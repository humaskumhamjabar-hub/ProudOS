APP_NAME=PROUD
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=361
REDIS_QUEUE_RETRY_AFTER=361

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Default: local di local/development/testing, backup_s3 di production.
# Jangan set ke local di production; gunakan storage luar server, misalnya S3/Backblaze.
# BACKUP_DISK=backup_s3
BACKUP_NOTIFICATION_EMAIL="hello@example.com"
BACKUP_ARCHIVE_PASSWORD=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=ap-southeast-1
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_PATH_STYLE=false

VITE_APP_NAME="${APP_NAME}"

# Nilai ini hanya fallback awal sebelum superadmin menyimpan konfigurasi melalui
# Pengaturan AI. Jangan commit API key yang sebenarnya ke repository.
AI_PROVIDER=nonaktif
AI_BASE_URL=https://router.mexia.me/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=90
AI_PROMPT_VERSION=berita-atensi-v1

# Lokasi executable Chromium/Chrome untuk render carousel PNG.
CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
